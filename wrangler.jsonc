{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kia",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
  },
  // Static site built by `yarn build`. Only /api/* requests reach the Worker code;
  // everything else is served directly from the assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    {
      "pattern": "kia.bengawalk.com",
      "custom_domain": true,
    },
  ],
  // Per-IP limit for the Google proxy endpoints
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  // Secrets (set with `wrangler secret put`, or `.dev.vars` locally):
  // - GOOGLE_MAPS_API_KEY
}
